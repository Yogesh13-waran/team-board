# TeamBoard Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Django Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database Configuration (used by Django and Docker Compose)
DB_NAME=teamboard_db
DB_USER=teamboard_user
DB_PASSWORD=teamboard_secure_pass_2026
DB_HOST=127.0.0.1
DB_PORT=5432

# SimpleJWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
