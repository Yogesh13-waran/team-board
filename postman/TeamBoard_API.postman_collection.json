				{
					"name": "Scenario 7: POST /api/kb/query/ - Success With Matches (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains search, count > 0, and results array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('search');",
									"    pm.expect(jsonData).to.have.property('count');",
									"    pm.expect(jsonData).to.have.property('results');",
									"    pm.expect(jsonData.count).to.be.above(0);",
									"    pm.expect(jsonData.results).to.be.an('array');",
									"    pm.expect(jsonData.results[0]).to.have.property('question');",
									"    pm.expect(jsonData.results[0]).to.have.property('answer');",
									"    pm.expect(jsonData.results[0]).to.have.property('category');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
